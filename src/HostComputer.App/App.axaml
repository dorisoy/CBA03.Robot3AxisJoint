<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HostComputer.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Microsoft YaHei, sans-serif" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#0C121B" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#215870" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#AD3645" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#141E2B" />
      <Setter Property="BorderBrush" Value="#293649" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Styles>
</Application>
